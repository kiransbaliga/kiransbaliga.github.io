---
import Search from "@/components/Search.astro";

const pathname = Astro.url.pathname;
const isHome = pathname === "/";
// Search is only shown on the writings / blog section, not on home, work together, or projects
const isWritingPage = pathname.startsWith("/posts") || pathname.startsWith("/tags") || pathname.startsWith("/notes");
---

<header
	class="mb-6 flex items-center justify-between pt-4 pb-2 text-[#262625]"
	id="main-header"
>
	<div class="flex items-center gap-6 sm:gap-8">
		<a
			aria-current={isHome ? "page" : false}
			class="font-sans text-[14px] font-semibold tracking-tight transition-opacity hover:opacity-75"
			href="/"
		>
			Kiran S Baliga
		</a>

		<nav
			aria-label="Main menu"
			class="hidden items-center gap-5 font-sans text-[13px] text-[#262625] sm:flex"
			id="navigation-menu"
		>
			<a
				class="hover:text-accent transition-colors duration-200"
				href={isHome ? "#work" : "/#work"}
			>
				Work
			</a>
			<a
				class="hover:text-accent transition-colors duration-200"
				href="/projects/"
			>
				Projects
			</a>
			<a
				class="hover:text-accent transition-colors duration-200"
				href="/posts/"
			>
				Writing ↗
			</a>
			<a
				class="hover:text-accent transition-colors duration-200"
				href="/work-together/"
			>
				Work together
			</a>
		</nav>
	</div>

	<div class="flex items-center gap-2">
		{isWritingPage && <Search />}
		<mobile-button class="sm:hidden">
			<button
				aria-expanded="false"
				aria-haspopup="menu"
				class="border-line text-muted hover:border-accent hover:text-accent flex h-7 w-7 cursor-pointer items-center justify-center rounded-full border transition-all duration-200"
				id="toggle-navigation-menu"
				type="button"
			>
				<span class="sr-only">Open main menu</span>
				<div class="flex flex-col gap-1">
					<span class="h-0.5 w-3 bg-current transition-transform"></span>
					<span class="h-0.5 w-3 bg-current transition-transform"></span>
				</div>
			</button>
		</mobile-button>
	</div>
</header>

<div
	class="bg-global-bg/95 border-line mb-6 hidden flex-col gap-3 border-b pb-4 font-sans text-sm sm:hidden"
	id="mobile-menu"
>
	<a class="py-1 hover:text-accent" href={isHome ? "#work" : "/#work"}>Work</a>
	<a class="py-1 hover:text-accent" href="/projects/">Projects</a>
	<a class="py-1 hover:text-accent" href="/posts/">Writing ↗</a>
	<a class="py-1 hover:text-accent" href="/work-together/">Work together</a>
</div>

<script>
	const btn = document.getElementById("toggle-navigation-menu");
	const menu = document.getElementById("mobile-menu");
	btn?.addEventListener("click", () => {
		menu?.classList.toggle("hidden");
		const expanded = btn.getAttribute("aria-expanded") === "true";
		btn.setAttribute("aria-expanded", (!expanded).toString());
	});
</script>
