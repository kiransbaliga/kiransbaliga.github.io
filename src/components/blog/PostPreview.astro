---
import type { CollectionEntry } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "@/components/FormattedDate.astro";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	post: CollectionEntry<"post">;
	withDesc?: boolean;
};

const { as: Tag = "div", post, withDesc = false } = Astro.props;
---

<FormattedDate class="font-mono text-xs uppercase tracking-wider text-muted min-w-28 pt-0.5" date={post.data.publishDate} />
<div class="flex flex-col">
	<Tag class="font-sans font-medium text-base">
		{post.data.draft && <span class="border-red-500/30 text-red-500 me-2 rounded-full border px-2 py-0.5 font-mono text-xs uppercase">Draft</span>}
		{
			post.data.externalUrl ? (
				<a class="hover:text-accent inline-flex items-center gap-1 transition-colors duration-200" href={post.data.externalUrl} target="_blank" rel="noopener noreferrer">
					<span>{post.data.title}</span>
					<span class="text-muted font-mono text-xs">↗</span>
				</a>
			) : (
				<a class="hover:text-accent transition-colors duration-200" href={`/posts/${post.id}/`}>
					{post.data.title}
				</a>
			)
		}
	</Tag>
	{withDesc && post.data.description && <p class="text-muted mt-1 text-sm leading-relaxed line-clamp-2">{post.data.description}</p>}
</div>
