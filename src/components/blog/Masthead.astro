---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";

interface Props {
	content: CollectionEntry<"post">;
	readingTime: string;
}

const {
	content: { data },
	readingTime,
} = Astro.props;

const dateTimeOptions: Intl.DateTimeFormatOptions = {
	month: "short",
	day: "numeric",
	year: "numeric",
};
---

{
	data.coverImage && (
		<div class="mb-6 aspect-video overflow-hidden rounded border border-[#deded8] bg-white">
			<Image
				alt={data.coverImage.alt}
				layout="constrained"
				width={748}
				height={420}
				priority
				class="h-full w-full object-cover"
				src={data.coverImage.src}
			/>
		</div>
	)
}

{data.draft ? <span class="border-red-500/30 text-red-600 mb-2 inline-block rounded-full border px-2 py-0.5 font-mono text-[11px] uppercase">Draft</span> : null}

<h1 class="font-sans text-[26px] sm:text-[28px] leading-[1.25] font-normal text-[#262625] mb-3">
	{data.title}
</h1>

<div class="flex flex-wrap items-center gap-x-3 gap-y-2 font-sans text-xs text-[#797974]">
	<p>
		<FormattedDate date={data.publishDate} dateTimeOptions={dateTimeOptions} />
		<span class="mx-1.5 text-[#deded8]">&middot;</span>
		<span>{readingTime}</span>
	</p>
	{
		data.updatedDate && (
			<span class="rounded-full border border-[#deded8] px-2 py-0.5 text-[11px]">
				Updated:
				<FormattedDate class="ms-1" date={data.updatedDate} dateTimeOptions={dateTimeOptions} />
			</span>
		)
	}
</div>

{
	!!data.tags?.length && (
		<div class="mt-3.5 flex flex-wrap items-center gap-1.5">
			{data.tags.map((tag) => (
				<a
					class="font-mono text-[11px] px-2 py-0.5 rounded bg-[#f4f3ef] text-[#444441] hover:text-accent hover:bg-[#eae8e2] transition-colors duration-150"
					data-pagefind-filter={`tag:${tag}`}
					href={`/tags/${tag}/`}
				>
					#{tag}
				</a>
			))}
		</div>
	)
}
