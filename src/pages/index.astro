---
import PageLayout from "@/layouts/Base.astro";
import { getAllPosts } from "@/data/post";

const allPosts = await getAllPosts();
// Filter out draft posts and sort descending by date
const blogPosts = allPosts
	.filter((p) => !p.data.draft)
	.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<PageLayout meta={{ title: "Kiran S Baliga — Backend & AI Engineer", description: "Backend & AI Engineer. I build systems that power products at scale — distributed backends, clinical LLM pipelines, on-device vitals, and developer tooling across Ultrahuman, Pencil, and KeyValue." }}>
	{/* A Personal Introduction */}
	<section class="pt-2 pb-6 sm:pt-4 sm:pb-8 relative">
		<span class="block font-sans text-xs text-[#797974] mb-2">
			Backend & AI Engineer
		</span>

		<h1 class="font-sans text-[26px] sm:text-[28px] leading-[1.25] font-normal text-[#262625] mb-3">
			Hi, I’m Kiran.
		</h1>

		<div class="space-y-2.5 font-sans text-[14.5px] leading-[1.55] text-[#444441] max-w-2xl mb-5">
			<p>
				I build systems that power products at scale. Usually, that means making complicated things work quietly in the background.
			</p>
			<p>
				I’ve worked on consumer health tech at <a href="/work/ultrahuman/" class="text-[#262625] underline underline-offset-[3px] decoration-[#b0afaa] hover:text-accent hover:decoration-[#16a34a] transition-colors duration-150">Ultrahuman</a>, B2B AI advertising infrastructure at <a href="/work/pencil/" class="text-[#262625] underline underline-offset-[3px] decoration-[#b0afaa] hover:text-accent hover:decoration-[#16a34a] transition-colors duration-150">Pencil</a>, and developer SDKs at <a href="https://www.keyvalue.systems/" target="_blank" rel="noopener noreferrer" class="text-[#262625] underline underline-offset-[3px] decoration-[#b0afaa] hover:text-accent hover:decoration-[#16a34a] transition-colors duration-150">KeyValue</a>. My work sits somewhere between distributed systems, LLM orchestration, MCP servers, and developer tooling.
			</p>
			<p>
				Outside that, I make small tools for the way I live, and write about the questions they leave me with.
			</p>
		</div>

		{/* Availability & Links with marginalia OUTSIDE normal text bounds */}
		<div class="relative flex flex-wrap items-center gap-x-5 gap-y-3 mb-3">
			{/* Mobile note: sits above the row on narrow screens */}
			<div class="md:hidden w-full select-none -mb-1">
				<span class="font-handwriting text-base text-[#262625] rotate-[-2deg] inline-block">
					for the right next thing &rarr;
				</span>
			</div>

			{/* Circled invitation with authentic ink loop at standard text bounds */}
			<div class="relative inline-flex items-center px-3 py-1 select-none">
				{/* Desktop marginalia outside normal text bounds in left gutter */}
				<span
					class="hidden md:inline-flex items-center gap-1.5 absolute right-full mr-3 top-1/2 -translate-y-1/2 select-none whitespace-nowrap font-handwriting text-[18px] text-[#262625] rotate-[-2deg] pointer-events-none"
				>
					for the right next thing &rarr;
				</span>

				<span class="font-sans text-[13.5px] text-[#262625] relative z-10">
					Available immediately
				</span>
				<svg
					class="pointer-events-none absolute -inset-x-2 -inset-y-1 w-[calc(100%+16px)] h-[calc(100%+8px)] overflow-visible"
					viewBox="0 0 209 48"
					fill="none"
					preserveAspectRatio="none"
					xmlns="http://www.w3.org/2000/svg"
					aria-hidden="true"
				>
					<path
						d="M162.029 2.92454C84.1186 -3.19881 1.99694 4.14921 0.944102 26.1933C-3.26726 49.462 138.866 53.1361 205.195 37.2153C220.988 16.3959 171.504 -3.19881 103.07 2.92454"
						stroke-width="1.7"
						stroke="#16a34a"
					/>
					<path
						d="M20 38C83.6775 49 166.414 41 186.594 25"
						stroke-width="1.3"
						stroke="#16a34a"
					/>
				</svg>
			</div>

			<a
				class="font-sans text-[14px] text-[#262625] hover:text-accent transition-colors duration-200"
				href="/work-together/"
			>
				Work together &rarr;
			</a>

			<a
				class="font-sans text-[12.5px] text-[#797974] hover:text-accent transition-colors duration-200"
				href="/resume.pdf"
				target="_blank"
				rel="noopener noreferrer"
			>
				R&eacute;sum&eacute; &nearr;
			</a>
		</div>

		<p class="font-sans text-[12px] text-[#797974]">
			Based in Kerala, India &middot; Open to full-time, remote &amp; relocation
		</p>
	</section>

	{/* Selected Professional Work */}
	<section id="work" class="border-t border-[#deded8] pt-5 pb-7">
		<h2 class="font-sans text-[16px] font-medium text-[#262625] mb-0.5">
			Selected work
		</h2>
		<p class="font-sans text-[12.5px] text-[#797974] mb-5">
			A few systems I&rsquo;ve helped make more useful, reliable and easier to build on.
		</p>

		<div class="space-y-6">
			{/* Case Study 1: Ultrahuman */}
			<article class="space-y-1.5">
				<div>
					<h3 class="font-sans text-[14.5px] font-medium">
						<a
							class="text-[#262625] hover:text-accent transition-colors duration-200"
							href="/work/ultrahuman/"
						>
							Ultrahuman &rarr;
						</a>
					</h3>
				</div>
				<p class="font-sans text-[12px] text-[#797974]">
					Backend Engineer
				</p>
				<p class="font-sans text-[13.5px] leading-[1.5] text-[#444441]">
					Clinical reporting across 10+ lab stations, on-device vital computation in KMP, and a dynamic biometric upsell pipeline evaluating cohorts across 5M+ platform users.
				</p>
				<p class="font-sans text-[12.5px] text-[#262625]">
					8,000+ Powerplug conversions &middot; ~80% vital latency cut &middot; 86% &rarr; 91% CJK localization
				</p>
			</article>

			{/* Case Study 2: Pencil */}
			<article class="space-y-1.5">
				<div>
					<h3 class="font-sans text-[14.5px] font-medium">
						<a
							class="text-[#262625] hover:text-accent transition-colors duration-200"
							href="/work/pencil/"
						>
							Pencil &rarr;
						</a>
					</h3>
				</div>
				<p class="font-sans text-[12px] text-[#797974]">
					Client engagement &middot; via KeyValue Software Systems
				</p>
				<p class="font-sans text-[13.5px] leading-[1.5] text-[#444441]">
					Reworking the data layer and PDF pipeline behind a multi-tenant AI ad platform. Tenant boundaries belong in the infrastructure.
				</p>
				<p class="font-sans text-[12.5px] text-[#262625]">
					30% faster API responses &middot; 65% less PDF rendering processing time
				</p>
			</article>

			{/* Case Study 3: Siren */}
			<article class="space-y-1.5">
				<div>
					<h3 class="font-sans text-[14.5px] font-medium">
						<a
							class="text-[#262625] hover:text-accent transition-colors duration-200"
							href="/work/siren/"
						>
							Siren &rarr;
						</a>
					</h3>
				</div>
				<p class="font-sans text-[12px] text-[#797974]">
					Client engagement &middot; via KeyValue Software Systems
				</p>
				<p class="font-sans text-[13.5px] leading-[1.5] text-[#444441]">
					Shared tool schemas, TypeScript and Python agent toolkits, and a standalone MCP server for AI-native communications.
				</p>
				<p class="font-sans text-[12.5px] text-[#262625]">
					~75% less setup effort with zero-install MCP vs. manual SDK wiring
				</p>
			</article>
		</div>
	</section>

	{/* Writing */}
	<section class="border-t border-[#deded8] pt-5 pb-7">
		<div class="flex items-baseline justify-between mb-3">
			<h2 class="font-sans text-[13px] font-medium text-[#797974]">
				Writing
			</h2>
			<a
				class="font-sans text-[12px] text-[#797974] hover:text-accent transition-colors duration-200"
				href="/posts/"
			>
				All posts &nearr;
			</a>
		</div>

		<div class="grid grid-cols-[44px_1fr] sm:grid-cols-[56px_1fr] gap-3 items-start">
			<span class="font-mono text-[12px] text-[#797974] select-none pt-0.5">
				2026
			</span>

			<ul class="space-y-2" role="list">
				{
					blogPosts.slice(0, 4).map((post, idx) => {
						const dateFormatted = new Intl.DateTimeFormat("en-GB", {
							day: "numeric",
							month: "short",
						}).format(post.data.publishDate);

						const postUrl = post.data.externalUrl ?? `/posts/${post.id}/`;

						return (
							<li class="flex items-baseline justify-between gap-4 py-0.5 group">
								<div class="flex items-baseline gap-2 min-w-0">
									<a
										class="font-sans text-[13.5px] text-[#262625] hover:text-accent transition-colors duration-200 truncate"
										href={postUrl}
										target={post.data.externalUrl ? "_blank" : undefined}
										rel={post.data.externalUrl ? "noopener noreferrer" : undefined}
									>
										{post.data.title}
									</a>
									{idx === 0 && (
										<span class="inline-flex items-center px-1.5 py-0.2 text-[10px] font-sans font-medium text-[#16a34a] border border-[#16a34a]/30 rounded-full select-none shrink-0">
											New
										</span>
									)}
								</div>
								<span class="font-sans text-[12px] text-[#797974] whitespace-nowrap tabular-nums shrink-0">
									{dateFormatted}
								</span>
							</li>
						);
					})
				}
			</ul>
		</div>
	</section>

	{/* A Little More About Me */}
	<section class="border-t border-[#deded8] pt-5 pb-4">
		<h2 class="font-sans text-[16px] font-medium text-[#262625] mb-2.5">
			A little more about me
		</h2>

		<div class="space-y-2 font-sans text-[13.5px] leading-[1.55] text-[#444441] max-w-2xl mb-4">
			<p>
				My path has taken me from Flutter apps at airPMO and a mental-health platform at TGH Tech to backend and AI infrastructure at KeyValue and Ultrahuman.
			</p>
			<p>
				I’m looking for my next full-time backend / AI engineering role. I also work with founders and agencies on focused consulting and freelance projects &mdash; from an early scope to a system people can actually use.
			</p>
		</div>

		{/* Clean gap layout avoiding collision between links and marginalia */}
		<div class="pt-2 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
			<div class="flex flex-wrap items-center gap-x-5 gap-y-2">
				<a
					class="font-sans text-[14px] text-[#262625] hover:text-accent transition-colors duration-200"
					href="/work-together/"
				>
					More about me &amp; working together &rarr;
				</a>

				<a
					class="font-sans text-[14px] text-[#262625] hover:text-accent transition-colors duration-200"
					href="mailto:kiransbaliga@gmail.com"
				>
					kiransbaliga@gmail.com &nearr;
				</a>
			</div>

			<div class="flex items-center gap-2 select-none self-start sm:self-auto shrink-0">
				<span class="font-handwriting text-lg text-[#262625] rotate-[-2deg] whitespace-nowrap">
					let’s build something useful
				</span>
				<svg
					class="w-7 h-3.5 text-[#262625] shrink-0"
					viewBox="0 0 123 55"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
					aria-hidden="true"
				>
					<path
						d="M121.625 0.099375C127.884 40.8034 64.039 43.0647 1.44597 48.718M21.4757 54.3714L1.44597 48.718L16.4683 37.4114"
						stroke-width="2"
						stroke="currentColor"
					/>
				</svg>
			</div>
		</div>
	</section>
</PageLayout>
