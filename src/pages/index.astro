---
import PageLayout from "@/layouts/Base.astro";
import { getAllPosts } from "@/data/post";

const allPosts = await getAllPosts();
// Filter out draft posts and sort descending by date
const blogPosts = allPosts
	.filter((p) => !p.data.draft)
	.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<PageLayout meta={{ title: "Kiran S Baliga — Backend & AI Engineer" }}>
	{/* A Personal Introduction */}
	<section class="pt-6 pb-14 sm:pt-8 sm:pb-16 relative">
		<span class="block font-sans text-sm text-[#797974] dark:text-neutral-400 mb-3">
			Backend & AI Engineer
		</span>

		<h1 class="font-sans text-[34px] leading-[1.3] font-normal text-[#262625] dark:text-[#f5f4f1] mb-6">
			Hi, I’m Kiran.
		</h1>

		<div class="space-y-4 font-sans text-[17px] leading-[1.65] text-[#444441] dark:text-neutral-300 max-w-2xl mb-8">
			<p>
				I build systems that power products at scale. Usually, that means making complicated things work quietly in the background.
			</p>
			<p>
				I’ve worked on Ultrahuman’s 5M+ user platform, B2B AI ad infrastructure at Pencil, and developer SDKs at KeyValue. My work sits somewhere between distributed systems, LLM orchestration, MCP servers and developer tooling.
			</p>
			<p>
				Outside that, I make small tools for the way I live, and write about the questions they leave me with.
			</p>
		</div>

		{/* Availability & Links with marginalia on the LEFT */}
		<div class="relative flex flex-wrap items-center gap-x-6 gap-y-4 mb-6">
			{/* Left margin note on desktop / tablet */}
			<div class="hidden md:block absolute -left-28 lg:-left-36 top-1/2 -translate-y-1/2 select-none text-right pointer-events-none">
				<span class="font-handwriting text-2xl text-[#262625] dark:text-neutral-400 leading-[1.1] rotate-[-5deg] block">
					for the<br />right next<br />thing
				</span>
			</div>

			{/* Left inline note on mobile */}
			<div class="md:hidden w-full select-none -mb-2">
				<span class="font-handwriting text-xl text-[#262625] dark:text-neutral-400 rotate-[-3deg] inline-block">
					for the right next thing &rarr;
				</span>
			</div>

			{/* Circled invitation with authentic ink loop */}
			<div class="relative inline-flex items-center px-4 py-2 select-none">
				<span class="font-sans text-base text-[#262625] dark:text-[#f5f4f1] relative z-10">
					Available immediately
				</span>
				<svg
					class="pointer-events-none absolute -inset-x-2 -inset-y-1.5 w-[calc(100%+16px)] h-[calc(100%+12px)] overflow-visible"
					viewBox="0 0 209 48"
					fill="none"
					preserveAspectRatio="none"
					xmlns="http://www.w3.org/2000/svg"
					aria-hidden="true"
				>
					<path
						d="M162.029 2.92454C84.1186 -3.19881 1.99694 4.14921 0.944102 26.1933C-3.26726 49.462 138.866 53.1361 205.195 37.2153C220.988 16.3959 171.504 -3.19881 103.07 2.92454"
						stroke-width="1.7"
						stroke="#EE2796"
					/>
					<path
						d="M20 38C83.6775 49 166.414 41 186.594 25"
						stroke-width="1.3"
						stroke="#EE2796"
					/>
				</svg>
			</div>

			<a
				class="font-sans text-[17px] text-[#262625] hover:text-accent transition-colors duration-200 dark:text-[#f5f4f1]"
				href="/work-together/"
			>
				Work together &rarr;
			</a>

			<a
				class="font-sans text-sm text-[#262625] hover:text-accent transition-colors duration-200 dark:text-[#f5f4f1]"
				href="/resume.pdf"
				target="_blank"
				rel="noopener noreferrer"
			>
				R&eacute;sum&eacute; &nearr;
			</a>
		</div>

		<p class="font-sans text-sm text-[#797974] dark:text-neutral-400">
			Based in Kerala, India &middot; Open to full-time, remote &amp; relocation
		</p>
	</section>

	{/* Selected Professional Work */}
	<section id="work" class="border-t border-[#deded8] pt-10 pb-14 dark:border-neutral-800">
		<h2 class="font-sans text-[23px] font-normal text-[#262625] dark:text-[#f5f4f1] mb-1">
			Selected work
		</h2>
		<p class="font-sans text-sm text-[#797974] dark:text-neutral-400 mb-8">
			A few systems I&rsquo;ve helped make more useful, reliable and easier to build on.
		</p>

		<div class="space-y-10">
			{/* Case Study 1: Ultrahuman */}
			<article class="space-y-2">
				<div class="flex items-baseline justify-between gap-4">
					<h3 class="font-sans text-[17px] font-normal">
						<a
							class="text-[#262625] hover:text-accent transition-colors duration-200 dark:text-[#f5f4f1]"
							href="/work/ultrahuman/"
						>
							Ultrahuman &rarr;
						</a>
					</h3>
					<span class="font-sans text-[13px] text-[#797974] dark:text-neutral-400 tabular-nums">
						Mar&ndash;Jun 2026
					</span>
				</div>
				<p class="font-sans text-[13px] text-[#797974] dark:text-neutral-400">
					Backend Engineer
				</p>
				<p class="font-sans text-[17px] leading-[1.65] text-[#444441] dark:text-neutral-300">
					Clinical reporting across 10+ lab stations: asynchronous ingestion and normalization, LLM analysis, clinician review and targeted regeneration of 15-page health plans.
				</p>
				<p class="font-sans text-sm text-[#262625] dark:text-[#f5f4f1]">
					Also: CJK localization quality 86% &rarr; 91%, with ~67% lower translation token costs.
				</p>
			</article>

			{/* Case Study 2: Pencil */}
			<article class="space-y-2">
				<div class="flex items-baseline justify-between gap-4">
					<h3 class="font-sans text-[17px] font-normal">
						<a
							class="text-[#262625] hover:text-accent transition-colors duration-200 dark:text-[#f5f4f1]"
							href="/work/pencil/"
						>
							Pencil &rarr;
						</a>
					</h3>
					<span class="font-sans text-[13px] text-[#797974] dark:text-neutral-400 tabular-nums">
						Sep 2023&ndash;Feb 2026
					</span>
				</div>
				<p class="font-sans text-[13px] text-[#797974] dark:text-neutral-400">
					Client engagement &middot; via KeyValue Software Systems
				</p>
				<p class="font-sans text-[17px] leading-[1.65] text-[#444441] dark:text-neutral-300">
					Reworking the data layer and PDF pipeline behind a multi-tenant AI ad platform. Tenant boundaries belong in the infrastructure.
				</p>
				<p class="font-sans text-sm text-[#262625] dark:text-[#f5f4f1]">
					30% faster API responses &middot; 65% less PDF rendering processing time
				</p>
			</article>

			{/* Case Study 3: Siren */}
			<article class="space-y-2">
				<div class="flex items-baseline justify-between gap-4">
					<h3 class="font-sans text-[17px] font-normal">
						<a
							class="text-[#262625] hover:text-accent transition-colors duration-200 dark:text-[#f5f4f1]"
							href="/work/siren/"
						>
							Siren &rarr;
						</a>
					</h3>
					<span class="font-sans text-[13px] text-[#797974] dark:text-neutral-400 tabular-nums">
						Sep 2023&ndash;Feb 2026
					</span>
				</div>
				<p class="font-sans text-[13px] text-[#797974] dark:text-neutral-400">
					Client engagement &middot; via KeyValue Software Systems
				</p>
				<p class="font-sans text-[17px] leading-[1.65] text-[#444441] dark:text-neutral-300">
					Shared tool schemas, TypeScript and Python agent toolkits, and a standalone MCP server for AI-native communications.
				</p>
				<p class="font-sans text-sm text-[#262625] dark:text-[#f5f4f1]">
					~75% less setup effort with zero-install MCP vs. manual SDK wiring
				</p>
			</article>
		</div>
	</section>

	{/* Writing (Moved UP as requested) */}
	<section class="border-t border-[#deded8] pt-10 pb-14 dark:border-neutral-800">
		<div class="flex items-baseline justify-between mb-8">
			<h2 class="font-sans text-[23px] font-normal text-[#262625] dark:text-[#f5f4f1]">
				Writing
			</h2>
			<a
				class="font-sans text-sm text-[#797974] hover:text-accent transition-colors duration-200 dark:text-neutral-400"
				href="/posts/"
			>
				All posts &nearr;
			</a>
		</div>

		<div class="grid grid-cols-[50px_1fr] sm:grid-cols-[64px_1fr] gap-4 items-start">
			<span class="font-mono text-[13px] text-[#797974] dark:text-neutral-400 select-none pt-0.5">
				2026
			</span>

			<ul class="space-y-3" role="list">
				{
					blogPosts.slice(0, 4).map((post) => {
						const dateFormatted = new Intl.DateTimeFormat("en-GB", {
							day: "numeric",
							month: "short",
						}).format(post.data.publishDate);

						const postUrl = post.data.externalUrl ?? `/posts/${post.id}/`;

						return (
							<li class="flex items-baseline justify-between gap-6 group">
								<a
									class="font-sans text-[16px] text-[#262625] hover:text-accent transition-colors duration-200 dark:text-[#f5f4f1]"
									href={postUrl}
									target={post.data.externalUrl ? "_blank" : undefined}
									rel={post.data.externalUrl ? "noopener noreferrer" : undefined}
								>
									{post.data.title}
								</a>
								<span class="font-sans text-[13px] text-[#797974] dark:text-neutral-400 whitespace-nowrap tabular-nums">
									{dateFormatted}
								</span>
							</li>
						);
					})
				}
			</ul>
		</div>
	</section>

	{/* Things I Make (Moved DOWN as requested) */}
	<section class="border-t border-[#deded8] pt-10 pb-14 dark:border-neutral-800">
		<h2 class="font-sans text-[23px] font-normal text-[#262625] dark:text-[#f5f4f1] mb-6">
			Things I make
		</h2>

		<div class="space-y-6">
			<div>
				<a
					class="font-sans text-[17px] text-[#262625] hover:text-accent transition-colors duration-200 dark:text-[#f5f4f1]"
					href="https://github.com/kiransbaliga"
					target="_blank"
					rel="noopener noreferrer"
				>
					Valkyrie &nearr;
				</a>
				<p class="font-sans text-sm text-[#797974] dark:text-neutral-400 mt-1">
					A native macOS wallpaper companion. Folder-based gallery, Metal rendering.
				</p>
			</div>

			<div>
				<a
					class="font-sans text-[17px] text-[#262625] hover:text-accent transition-colors duration-200 dark:text-[#f5f4f1]"
					href="https://github.com/kiransbaliga"
					target="_blank"
					rel="noopener noreferrer"
				>
					Lyrix &nearr;
				</a>
				<p class="font-sans text-sm text-[#797974] dark:text-neutral-400 mt-1">
					Floating lyrics for macOS, driven by Now Playing. No audio recording.
				</p>
			</div>

			<div>
				<a
					class="font-sans text-[17px] text-[#262625] hover:text-accent transition-colors duration-200 dark:text-[#f5f4f1]"
					href="/posts/poor-decisions/"
				>
					Poor Decisions &nearr;
				</a>
				<p class="font-sans text-sm text-[#797974] dark:text-neutral-400 mt-1">
					Five-second expense logging with iOS Shortcuts and Google Sheets.
				</p>
			</div>

			<div>
				<a
					class="font-sans text-[17px] text-[#262625] hover:text-accent transition-colors duration-200 dark:text-[#f5f4f1]"
					href="/posts/readfaster/"
				>
					Read Faster &nearr;
				</a>
				<p class="font-sans text-sm text-[#797974] dark:text-neutral-400 mt-1">
					An RSVP speed reader built around the optimal recognition point.
				</p>
			</div>

			<div>
				<a
					class="font-sans text-[17px] text-[#262625] hover:text-accent transition-colors duration-200 dark:text-[#f5f4f1]"
					href="https://github.com/kiransbaliga"
					target="_blank"
					rel="noopener noreferrer"
				>
					Multi-Task Federated Learning &nearr;
				</a>
				<p class="font-sans text-sm text-[#797974] dark:text-neutral-400 mt-1">
					Collaborative multi-task training; raw data stays local.
				</p>
			</div>
		</div>
	</section>

	{/* A Little More About Me (Gap issue resolved) */}
	<section class="border-t border-[#deded8] pt-10 pb-6 dark:border-neutral-800">
		<h2 class="font-sans text-[23px] font-normal text-[#262625] dark:text-[#f5f4f1] mb-5">
			A little more about me
		</h2>

		<div class="space-y-4 font-sans text-[17px] leading-[1.65] text-[#444441] dark:text-neutral-300 max-w-2xl mb-8">
			<p>
				My path has taken me from Flutter apps at airPMO and a mental-health platform at TGH Tech to backend and AI infrastructure at KeyValue and Ultrahuman.
			</p>
			<p>
				I’m looking for my next full-time backend / AI engineering role. I also work with founders and agencies on focused consulting and freelance projects &mdash; from an early scope to a system people can actually use.
			</p>
		</div>

		{/* Clean gap layout avoiding collision between links and marginalia */}
		<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 pt-2 mb-2">
			<div class="space-y-3">
				<div>
					<a
						class="font-sans text-[17px] text-[#262625] hover:text-accent transition-colors duration-200 dark:text-[#f5f4f1]"
						href="/work-together/"
					>
						More about me &amp; working together &rarr;
					</a>
				</div>

				<div>
					<a
						class="font-sans text-[17px] text-[#262625] hover:text-accent transition-colors duration-200 dark:text-[#f5f4f1]"
						href="mailto:kiransbaliga@gmail.com"
					>
						kiransbaliga@gmail.com &nearr;
					</a>
				</div>
			</div>

			{/* Handwritten marginalia cleanly spaced */}
			<div class="flex items-center gap-3 select-none self-start sm:self-end pt-2 sm:pt-0">
				<span class="font-handwriting text-2xl text-[#262625] dark:text-neutral-300 leading-tight rotate-[-3deg] whitespace-nowrap">
					let’s build<br />something useful
				</span>
				<svg
					class="w-[60px] h-[30px] text-[#262625] dark:text-neutral-300 shrink-0"
					viewBox="0 0 123 55"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
					aria-hidden="true"
				>
					<path
						d="M121.625 0.099375C127.884 40.8034 64.039 43.0647 1.44597 48.718M21.4757 54.3714L1.44597 48.718L16.4683 37.4114"
						stroke-width="1.8"
						stroke="currentColor"
					/>
				</svg>
			</div>
		</div>
	</section>
</PageLayout>
