---
import { type CollectionEntry } from "astro:content";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

const MAX_POSTS = 4;
const allPosts = await getAllPosts();
const latestPosts = allPosts
	.filter((p) => !p.data.draft)
	.sort(collectionDateSort)
	.slice(0, MAX_POSTS) as CollectionEntry<"post">[];
---

<PageLayout meta={{ title: "Home" }}>
	<!-- Header / Identity -->
	<header class="mb-5 sm:mb-6">
		<div class="flex flex-wrap items-baseline justify-between gap-3">
			<div>
				<h1 class="text-accent-2 font-sans text-2xl font-semibold tracking-tight sm:text-3xl">
					Kiran S Baliga
				</h1>
				<p class="text-muted mt-1 font-mono text-xs tracking-wider uppercase">
					Backend &amp; AI Engineer
				</p>
			</div>
			<a
				href="mailto:kiransbaliga@gmail.com"
				class="group border-line text-muted hover:border-accent hover:text-accent inline-flex items-center gap-1.5 rounded-full border px-3 py-1 font-mono text-xs tracking-wider uppercase transition-all duration-200"
			>
				<span class="group-hover:bg-accent h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-500"
				></span>
				<span>Available immediately</span>
				<span class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
					>&nearr;</span
				>
			</a>
		</div>
	</header>

	<!-- Bio -->
	<section
		class="text-global-text/90 mb-7 space-y-3 text-[15px] leading-relaxed sm:mb-8 sm:space-y-3.5 sm:text-base"
	>
		<p>
			Hi, I’m Kiran. I build systems that power products at scale. Usually, that means making
			complicated things work quietly in the background.
		</p>
		<p>
			Previously built clinical LLM reporting pipelines at <a
				href="/posts/ultrahuman-systems/"
				class="text-accent-2 decoration-line hover:decoration-accent hover:text-accent font-medium underline underline-offset-4 transition-colors duration-200"
				>Ultrahuman &nearr;</a
			>, multi-tenant ad data infrastructure at <a
				href="/posts/pencil-infrastructure/"
				class="text-accent-2 decoration-line hover:decoration-accent hover:text-accent font-medium underline underline-offset-4 transition-colors duration-200"
				>Pencil &nearr;</a
			>, and agent toolkits / MCP servers at <a
				href="/posts/siren-mcp-tooling/"
				class="text-accent-2 decoration-line hover:decoration-accent hover:text-accent font-medium underline underline-offset-4 transition-colors duration-200"
				>Siren &nearr;</a
			>. My work sits somewhere between distributed systems, LLM orchestration, and developer
			tooling.
		</p>
		<p>
			Outside that, I make small tools for the way I live&mdash;like <a
				href="https://github.com/kiransbaliga"
				target="_blank"
				rel="noopener noreferrer"
				class="text-accent-2 decoration-line hover:decoration-accent hover:text-accent font-medium underline underline-offset-4 transition-colors duration-200"
				>Valkyrie &nearr;</a
			> and <a
				href="https://github.com/kiransbaliga"
				target="_blank"
				rel="noopener noreferrer"
				class="text-accent-2 decoration-line hover:decoration-accent hover:text-accent font-medium underline underline-offset-4 transition-colors duration-200"
				>Lyrix &nearr;</a
			>&mdash;and write about the questions they leave me with.
		</p>
	</section>

	<!-- Writing & Case Studies Section -->
	<section class="border-line mb-6 border-y py-4 sm:mb-8 sm:py-5">
		<div class="mb-4 flex items-baseline justify-between">
			<h2 class="text-accent-2 font-sans text-base font-medium tracking-tight sm:text-lg">
				Writing
			</h2>
			<a
				href="/posts/"
				class="text-muted decoration-line hover:decoration-accent hover:text-accent font-sans text-xs underline underline-offset-4 transition-colors duration-200 sm:text-sm"
			>
				All posts &nearr;
			</a>
		</div>

		<ul class="space-y-3 sm:space-y-3.5" role="list">
			{
				latestPosts.map((post, index) => {
					const year = post.data.publishDate.getFullYear();
					const prevYear = index > 0 ? latestPosts[index - 1].data.publishDate.getFullYear() : null;
					const showYear = year !== prevYear;
					const isCaseStudy = post.data.tags?.includes("case-study") || Boolean(post.data.pinned);
					const formattedDate = new Intl.DateTimeFormat("en-GB", {
						day: "numeric",
						month: "short",
					}).format(post.data.publishDate);
					const postUrl = post.data.externalUrl ?? `/posts/${post.id}/`;
					const isExternal = Boolean(post.data.externalUrl);

					return (
						<li class="group grid grid-cols-[48px_1fr_auto] items-baseline gap-3 sm:grid-cols-[60px_1fr_auto] sm:gap-4">
							<span class="text-muted font-mono text-xs select-none sm:text-sm">
								{showYear ? year : ""}
							</span>

							<div class="flex min-w-0 items-baseline gap-2">
								<a
									href={postUrl}
									target={isExternal ? "_blank" : undefined}
									rel={isExternal ? "noopener noreferrer" : undefined}
									class="text-accent-2 decoration-line hover:decoration-accent hover:text-accent truncate font-sans text-[15px] underline underline-offset-4 transition-colors duration-200 sm:text-base"
								>
									{post.data.title}
								</a>
								{isCaseStudy && (
									<span class="bg-accent/10 text-accent inline-flex shrink-0 items-center rounded-full px-2 py-0.5 font-mono text-[10px] font-medium tracking-wider uppercase">
										Case Study
									</span>
								)}
							</div>

							<span class="text-muted text-right font-mono text-xs whitespace-nowrap tabular-nums sm:text-sm">
								{formattedDate}
							</span>
						</li>
					);
				})
			}
		</ul>
	</section>
</PageLayout>
