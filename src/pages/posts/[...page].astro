---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllPosts, getUniqueTags, groupPostsByYear } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (async ({ paginate }) => {
	const MAX_POSTS_PER_PAGE = 15;
	const MAX_TAGS = 8;
	const MAX_PINNED_POSTS = 3;
	const allPosts = await getAllPosts();
	const allPostsByDate = allPosts.sort(collectionDateSort);
	const uniqueTags = getUniqueTags(allPosts).slice(0, MAX_TAGS);
	const pinnedPosts = allPostsByDate
		.values()
		.filter((p) => p.data.pinned)
		.take(MAX_PINNED_POSTS)
		.toArray();
	return paginate(allPostsByDate, {
		pageSize: MAX_POSTS_PER_PAGE,
		props: { uniqueTags, pinnedPosts },
	});
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"post">>;
	uniqueTags: string[];
	pinnedPosts: CollectionEntry<"post">[];
}

const { page, uniqueTags, pinnedPosts } = Astro.props;

const meta = {
	description: "Notes, experiments, and essays on systems, backend infrastructure, and software.",
	title: "Writing — Kiran S Baliga",
};

const paginationProps = {
	...(page.url.prev && {
		prevUrl: {
			text: "← Previous Page",
			url: page.url.prev,
		},
	}),
	...(page.url.next && {
		nextUrl: {
			text: "Next Page →",
			url: page.url.next,
		},
	}),
};

const groupedByYear = groupPostsByYear(page.data);
const descYearKeys = Object.keys(groupedByYear).sort((a, b) => +b - +a);

// Identify newest post for the "New" badge
const newestPostId = page.data[0]?.id;
---

<PageLayout meta={meta}>
	<div class="pt-2 pb-10 sm:pt-4 sm:pb-14">
		{/* Minimal Header consistent with entire site */}
		<header class="mb-8">
			<span class="block font-sans text-xs text-[#797974] mb-2">
				Writing &middot; {page.data.length} posts
			</span>

			<h1 class="font-sans text-[26px] sm:text-[28px] leading-[1.25] font-normal text-[#262625] mb-2">
				Writing
			</h1>

			<p class="font-sans text-[14px] leading-[1.55] text-[#444441] max-w-2xl">
				Notes, experiments, and essays on systems, backend architecture, and developer tools.
			</p>
		</header>

		{/* Pinned Posts (if any) */}
		{
			pinnedPosts.length > 0 && page.currentPage === 1 && (
				<section class="border-t border-[#deded8] pt-5 pb-6">
					<h2 class="font-sans text-[13px] font-medium text-[#797974] mb-3 uppercase tracking-wider">
						Featured
					</h2>
					<ul class="space-y-1" role="list">
						{pinnedPosts.map((p) => (
							<li>
								<PostPreview post={p} isLatest={p.id === newestPostId} withDesc={false} />
							</li>
						))}
					</ul>
				</section>
			)
		}

		{/* Grouped by Year list */}
		<div class="space-y-7">
			{
				descYearKeys.map((yearKey) => (
					<section class="border-t border-[#deded8] pt-5">
						<div class="grid grid-cols-[44px_1fr] sm:grid-cols-[56px_1fr] gap-3 items-start">
							<span class="font-mono text-[12px] text-[#797974] select-none pt-1">
								{yearKey}
							</span>

							<ul class="space-y-1.5" role="list">
								{groupedByYear[yearKey]?.map((p) => (
									<li>
										<PostPreview post={p} isLatest={p.id === newestPostId} withDesc={false} />
									</li>
								))}
							</ul>
						</div>
					</section>
				))
			}
		</div>

		<div class="mt-8">
			<Pagination {...paginationProps} />
		</div>

		{/* Tags Filter */}
		{
			!!uniqueTags.length && (
				<section class="border-t border-[#deded8] pt-6 mt-10">
					<div class="flex items-center justify-between mb-3">
						<h2 class="font-sans text-[13px] font-medium text-[#797974]">
							Tags
						</h2>
						<a
							class="font-sans text-[12px] text-[#797974] hover:text-accent transition-colors duration-200"
							href="/tags/"
						>
							All tags &nearr;
						</a>
					</div>
					<div class="flex flex-wrap gap-2">
						{uniqueTags.map((tag) => (
							<a
								class="font-mono text-xs px-2.5 py-1 rounded bg-[#f4f3ef] text-[#444441] hover:text-accent hover:bg-[#eae8e2] transition-colors duration-150"
								href={`/tags/${tag}/`}
							>
								#{tag}
							</a>
						))}
					</div>
				</section>
			)
		}
	</div>
</PageLayout>
