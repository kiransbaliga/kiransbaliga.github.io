---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "About Kiran S Baliga — Freelance Full-Stack Developer & AI Systems Consultant",
	title: "About",
};
---

<PageLayout meta={meta}>
	<div class="mb-10 border-b border-line pb-4">
		<span class="eyebrow block mb-2">Profile &middot; Background</span>
		<h1 class="font-display text-4xl font-bold uppercase tracking-tight text-accent-2 sm:text-6xl">
			About Kiran
		</h1>
	</div>

	<div class="prose prose-cactus max-w-none">
		<p class="text-lg leading-relaxed text-global-text">
			I'm Kiran S Baliga &mdash; a freelance full-stack engineer and AI systems consultant based in Kerala &amp; Bangalore, India.
		</p>
		<p>
			Having built AI-powered health platforms serving 5M+ users at Ultrahuman and scalable infrastructure at KeyValue, I partner with founders and engineering organizations to turn complex technical challenges into refined, production-grade applications.
		</p>
		<p>
			My work spans the seam of distributed backend architecture, Model Context Protocol (MCP) tooling, autonomous multi-agent systems, and craft-driven web interfaces.
		</p>

		<h2 class="font-display text-2xl font-bold uppercase tracking-tight text-accent-2 mt-8 mb-4">
			Selected Capabilities
		</h2>
		<ul class="list-inside list-disc space-y-1.5" role="list">
			<li>AI agent systems, Model Context Protocol (MCP) servers, and LLM workflows</li>
			<li>High-performance web applications with React, TypeScript, and modern frontends</li>
			<li>Distributed backends with Ruby on Rails, Node.js, and Python FastAPI</li>
			<li>Database architecture, multi-tenant schemas, and query optimization</li>
		</ul>

		<div class="mt-10 pt-6 border-t border-line flex flex-wrap items-center gap-3">
			<a
				class="rounded-full bg-accent-2 text-global-bg px-5 py-2 font-mono text-xs uppercase tracking-wider font-semibold border border-accent-2 hover:bg-transparent hover:text-accent-2 transition-all duration-200"
				href="https://baliga.dev"
				target="_blank"
				rel="noreferrer noopener"
			>
				Explore Portfolio &nearr;
			</a>
			<a
				class="rounded-full border border-line px-5 py-2 font-mono text-xs uppercase tracking-wider text-muted hover:border-accent-2 hover:text-accent-2 transition-all duration-200"
				href="mailto:kiransbaliga@gmail.com"
			>
				Get in touch &nearr;
			</a>
		</div>
	</div>
</PageLayout>
