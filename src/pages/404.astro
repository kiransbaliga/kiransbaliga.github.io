// 404 Page - automatically redirects to homepage
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content="0;url=/" />
		<title>Redirecting to home...</title>
		<link rel="canonical" href="/" />
		<script is:inline>
			window.location.replace("/");
		</script>
	</head>
	<body class="bg-[#fefdfc] text-[#262625] font-sans flex items-center justify-center min-h-screen p-6">
		<p class="text-sm text-[#797974]">
			Redirecting to <a href="/" class="underline text-[#262625]">home</a>...
		</p>
	</body>
</html>
